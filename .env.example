# DayZ server settings.
#
#   1. Copy this file to ".env" (same folder).      Windows:  copy .env.example .env
#   2. Fill in the REQUIRED block.
#   3. Run:  docker-compose up -d     then watch:  docker-compose logs -f
#
# ".env" is git-ignored. Never commit it and never paste it anywhere.
#
# Rules for values (these are Docker Compose rules, all tested):
#   * Put passwords in SINGLE quotes if they contain $ # or spaces:   STEAM_PASSWORD='pa$$ #1'
#     (unquoted, "$" starts a variable and " #" starts a comment, so the value would be cut)
#   * Keep comments on their own lines, never after a value.
#   * A Steam password containing a double quote (") cannot be used.

# ============================ REQUIRED ========================================

# Steam account that downloads the server. Use the account that owns DayZ.
# (An account that does not own DayZ also works, but then the mission files come from
#  Bohemia's GitHub repository instead of Steam.)
STEAM_USERNAME=

# Needed for the FIRST login only. After "STEAM LOGIN CACHED" appears in the log you can
# blank it again. It is sent to Steam at most once per container.
#   * Steam Guard mobile app: keep your phone ready and approve the sign-in when the log says so.
#   * Steam Guard by email:   the first attempt makes Steam email you a code; put it into
#                             STEAM_GUARD_CODE below and run "docker-compose up -d" again.
#   * Steam Guard off:        nothing else to do.
STEAM_PASSWORD=
STEAM_GUARD_CODE=

# Name shown in the server browser.
SERVER_NAME=My DayZ Server

# ============================ COMMON ==========================================

# stable        normal server, joinable with the normal game                       (default)
# experimental  DayZ Experimental server. Works without an account
#               (STEAM_USERNAME=anonymous), but only "DayZ Experimental" clients can join.
DAYZ_BRANCH=stable

# Password players need to join. Empty = public server.
SERVER_PASSWORD=
# Password for the in-game admin login (#login <password>). Empty = admin login disabled.
ADMIN_PASSWORD=
SERVER_DESCRIPTION=
MAX_PLAYERS=60

# dayzOffline.chernarusplus = Chernarus, dayzOffline.enoch = Livonia, dayzOffline.sakhal = Sakhal
MISSION=dayzOffline.chernarusplus

DISABLE_THIRD_PERSON=false
DISABLE_CROSSHAIR=false

# "SystemTime" follows the clock of TZ below, or a fixed start such as 2026/06/01/09/00
SERVER_TIME=SystemTime
# 1 = real time. 12 makes a full day last two hours. Nights can be sped up separately.
TIME_ACCELERATION=1
NIGHT_TIME_ACCELERATION=1
TZ=UTC

# SteamID64 values (17 digits) that skip the login queue, separated by semicolons.
# Find yours at https://steamid.io - this is the only place a Steam ID is needed.
PRIORITY_STEAM_IDS=

# The server restarts itself this often (hours, 0 = never). It waits for an empty server,
# for up to two extra hours. Every restart also checks for a game update.
RESTART_INTERVAL_HOURS=6

# ============================ ADVANCED ========================================

# Caps the server's simulation rate. 60 keeps an idle server below 10 % of one CPU core.
LIMIT_FPS=60

# false = never contact Steam at start (keeps the installed build).
UPDATE_ON_START=true
# true = re-verify all 4 GB at every start. Slow; only useful after disk problems.
VALIDATE_ON_START=false

# true = also show the engine's very chatty debug stream in "docker-compose logs".
# The full logs are always kept in the data volume.
LOG_VERBOSE=false
LOG_RETENTION_DAYS=14

# Extra DayZServer launch parameters, separated by spaces.
EXTRA_ARGS=

# Only used when Steam does not deliver mission files (account without DayZ):
# branch, tag or commit of github.com/BohemiaInteractive/DayZ-Central-Economy
MISSIONS_REF=master

# ============================ STATUS PAGE =====================================
# The status page at http://localhost:8093 starts with the rest of the stack and needs no
# settings. Everything below is optional. See status/README.md.

# Address on THIS PC that the page is published on. 127.0.0.1 = this PC only.
# Use 0.0.0.0 to open it to your LAN - it shows player IDs, log contents and the container's
# settings, so only do that on a network you trust.
STATUS_BIND=127.0.0.1

# true blanks player and Steam IDs everywhere (handy for screenshots and streaming).
# The page also has a toggle button for this.
STATUS_REDACT_IDS=false

# How often the page samples the server for its player-count chart, and how long it keeps it.
STATUS_POLL_SECONDS=20
STATUS_HISTORY_DAYS=14

# true asks Steam whether a newer server build exists. This is the only request this whole
# stack ever makes to the internet on its own, so it is off by default.
STATUS_CHECK_STEAM_BUILD=false

# Group that is allowed to read the Docker socket. 0 is correct on Docker Desktop.
# On a Linux host use the gid from:  getent group docker
DOCKER_GID=0
