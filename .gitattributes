# Force LF everywhere: these files run inside a Linux container, and Git on
# Windows (core.autocrlf=true) would otherwise check them out with CRLF.
* text=auto eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.txt text eol=lf
.env.example text eol=lf
*.png binary
*.jpg binary
*.webp binary
*.jpeg binary
